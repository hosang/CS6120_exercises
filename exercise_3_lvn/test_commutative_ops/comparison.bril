@main {
  a: int = const 2;
  b: int = const 3;

  same1: bool = eq a b;
  same2: bool = eq b a;
  diff1: bool = ne a b;
  diff2: bool = ne b a;

  lt1: bool = lt a b;
  lt2: bool = gt b a;
  le1: bool = le a b;
  le2: bool = ge b a;

  gt1: bool = gt a b;
  gt2: bool = lt b a;
  ge1: bool = ge a b;
  ge2: bool = ge b a;
}